<ContentDialog
    x:Class="ConfigApp.EffectConfigDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Primary"
    Title="Effect Configuration"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    PrimaryButtonClick="OnPrimaryButtonClick"
    CornerRadius="8">

    <StackPanel Spacing="12">
        <TextBlock
            Text="Customize this effect’s behavior, duration, voting availability, and shortcut."
            TextWrapping="Wrap"
            Opacity="0.8" />

        <!-- Basic settings -->
        <StackPanel Spacing="6">
            <TextBlock Text="Basic" FontSize="16" FontWeight="SemiBold" />

            <Grid RowSpacing="6" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Rename Effect -->
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Rename Effect" />
                <TextBox
                    x:Name="effectconf_effect_custom_name"
                    Grid.Row="0"
                    Grid.Column="2"
                    PlaceholderText="Optional Custom Name"
                    MaxLength="64" />

                <!-- Timed Effect Type -->
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Timed Effect Type" />
                <CheckBox
                    x:Name="effectconf_timer_type_enable"
                    Grid.Row="1"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Content="Override"
                    Click="OnClicked" />
                <ComboBox
                    x:Name="effectconf_timer_type"
                    Grid.Row="1"
                    Grid.Column="2"
                    HorizontalAlignment="Left"
                    IsEnabled="False" />

                <!-- Timer Length -->
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Timer Length" />
                <CheckBox
                    x:Name="effectconf_timer_time_enable"
                    Grid.Row="2"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Content="Override"
                    Click="OnClicked" />
                <TextBox
                    x:Name="effectconf_timer_time"
                    Grid.Row="2"
                    Grid.Column="2"
                    PlaceholderText="Time in Seconds"
                    IsEnabled="False" />

                <!-- Weight -->
                <TextBlock
                    x:Name="effectconf_effect_weight_mult_title"
                    Grid.Row="3"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Effect Weight Multiplier" />
                <ComboBox
                    x:Name="effectconf_effect_weight_mult"
                    Grid.Row="3"
                    Grid.Column="2"
                    HorizontalAlignment="Left" />

                <!-- Voting -->
                <TextBlock
                    x:Name="effectconf_exclude_voting_enable_title"
                    Grid.Row="4"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Exclude from Voting" />
                <ComboBox
                    x:Name="effectconf_exclude_voting_state"
                    Grid.Row="4"
                    Grid.Column="2"
                    HorizontalAlignment="Left" />

                <!-- Shortcut -->
                <TextBlock
                    x:Name="effectconf_effect_shortcut_key_title"
                    Grid.Row="5"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Shortcut" />
                <CheckBox
                    x:Name="effectconf_effect_shortcut_enable"
                    Grid.Row="5"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Content="Enable"
                    Click="OnClicked" />
                <TextBox
                    x:Name="effectconf_effect_shortcut_input"
                    Grid.Row="5"
                    Grid.Column="2"
                    IsReadOnly="True"
                    IsEnabled="False"
                    Text="None"
                    PlaceholderText="Press shortcut keys"
                    KeyDown="EffectShortcutTextFieldKeyDown" />

                <!-- Hotkey Hint -->
                <TextBlock
                    Text="Press a key combination. Use Backspace or Escape to clear."
                    Grid.Row="6"
                    Grid.Column="2"
                    FontSize="12"
                    Opacity="0.7"
                    TextWrapping="Wrap" />
            </Grid>
        </StackPanel>

        <!-- Audio section -->
        <StackPanel x:Name="effectconf_audio_section" Spacing="6">
            <TextBlock Text="Audio" FontSize="16" FontWeight="SemiBold" />

            <Border
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
                <TextBlock
                    x:Name="effectconf_mp3_label"
                    TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </StackPanel>
</ContentDialog>