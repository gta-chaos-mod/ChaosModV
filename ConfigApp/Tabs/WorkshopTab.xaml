<UserControl
    x:Class="ConfigApp.Tabs.WorkshopTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="6" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                <TextBlock VerticalAlignment="Center" Text="Sort By:" />
                <ComboBox x:Name="SortingModeBox" Width="120" SelectedIndex="0" SelectionChanged="OnSortingModeBoxSelectionChanged">
                    <x:String>Name</x:String>
                    <x:String>Last Updated</x:String>
                    <x:String>Author</x:String>
                </ComboBox>
                <CheckBox x:Name="SortInstalledFirstToggle" VerticalAlignment="Center" IsChecked="True" Content="Show installed first" Click="OnSortInstalledFirstClick" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <TextBox x:Name="SearchBox" Width="250" PlaceholderText="Search" TextChanged="OnTextChangeSearch" />
                <Button Content="Settings" Click="OnSettingsClick" />
                <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefreshClick" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel x:Name="ItemsPanel" Spacing="0" />
        </ScrollViewer>
    </Grid>
</UserControl>