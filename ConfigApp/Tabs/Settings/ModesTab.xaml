<UserControl
    x:Class="ConfigApp.Tabs.Settings.ModesTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="12" Padding="6">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="Effect dispatch mode" VerticalAlignment="Center" />
                <ComboBox x:Name="DispatchModeComboBox" Width="130" SelectionChanged="OnDispatchModeSelectionChanged">
                    <x:String>Time</x:String>
                    <x:String>Distance</x:String>
                </ComboBox>
            </StackPanel>

            <StackPanel x:Name="TimePanel" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="New effect timer (in seconds)" VerticalAlignment="Center" Width="300" />
                    <TextBox x:Name="EffectDispatchTimerTextBox" Width="80" MaxLength="6" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Timed effect duration (in seconds)" VerticalAlignment="Center" Width="300" />
                    <TextBox x:Name="TimedEffectDurationTextBox" Width="80" MaxLength="6" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Short timed effect duration (in seconds)" VerticalAlignment="Center" Width="300" />
                    <TextBox x:Name="ShortTimedEffectDurationTextBox" Width="80" MaxLength="6" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="DistancePanel" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Distance to activate effect (in meters)" VerticalAlignment="Center" Width="300" />
                    <TextBox x:Name="DistanceBasedDispatchDistanceTextBox" Width="80" MaxLength="6" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Type of travel distance" VerticalAlignment="Center" Width="300" />
                    <ComboBox x:Name="DistanceBasedDispatchTypeComboBox" Width="150">
                        <x:String>Distance</x:String>
                        <x:String>Displacement</x:String>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Enable Crossing Challenge™" VerticalAlignment="Center" Width="300" />
                <CheckBox x:Name="EnableCrossingChallengeCheckBox" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>