<UserControl
    x:Class="ConfigApp.Tabs.Settings.SettingsTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settingsTabs="using:ConfigApp.Tabs.Settings">
    <Grid>
        <settingsTabs:GeneralTab x:Name="general_tab" />
        <settingsTabs:ModesTab x:Name="modes_tab" Visibility="Collapsed" />
        <settingsTabs:ShortcutsTab x:Name="shortcuts_tab" Visibility="Collapsed" />
        <settingsTabs:ColorsTab x:Name="colors_tab" Visibility="Collapsed" />
        <settingsTabs:SoundsTab x:Name="sounds_tab" Visibility="Collapsed" />
    </Grid>
</UserControl>