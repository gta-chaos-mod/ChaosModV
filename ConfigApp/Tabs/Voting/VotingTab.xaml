<UserControl
    x:Class="ConfigApp.Tabs.Voting.VotingTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:votingTabs="using:ConfigApp.Tabs.Voting">
    <TabView x:Name="voting_tabs" IsAddTabButtonVisible="False" SelectionChanged="OnSelectionChanged">
        <TabViewItem Header="General">
            <votingTabs:GeneralTab x:Name="general_tab" />
        </TabViewItem>
        <TabViewItem Header="Twitch">
            <votingTabs:TwitchTab x:Name="twitch_tab" />
        </TabViewItem>
        <TabViewItem Header="Discord">
            <votingTabs:DiscordTab x:Name="discord_tab" />
        </TabViewItem>
    </TabView>
</UserControl>