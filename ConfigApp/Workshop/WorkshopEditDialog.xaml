<ContentDialog x:Class="ConfigApp.WorkshopEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        DefaultButton="Primary">
    <Grid RowSpacing="10" MinWidth="520" MinHeight="420">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="files_info_text" Text="Disable any files from loading by unchecking the corresponding checkbox" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0" Grid.Row="0" Margin="6,0" />
        <TreeView x:Name="files_tree_view" VerticalAlignment="Stretch" Grid.Row="1" SelectionMode="None" />
        <TextBlock x:Name="install_confirm_text" Grid.Row="2" Text="Would you like to install this submission?" Visibility="Collapsed" Margin="6,0" />
    </Grid>
</ContentDialog>
