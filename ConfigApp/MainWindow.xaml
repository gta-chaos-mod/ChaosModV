<Window
    x:Class="ConfigApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ChaosModV Configuration">
    <Grid x:Name="MainRoot" Padding="12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabView x:Name="root_tabcontrol" SelectionChanged="OnTabSelectionChanged">
            <TabViewItem Header="Effects">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox
                        x:Name="effects_user_effects_search"
                        Width="300"
                        HorizontalAlignment="Left"
                        PlaceholderText="Search for effect..."
                        TextChanged="OnUserEffectSearchTextChanged" />
                    <TreeView
                        x:Name="effects_user_effects_tree_view"
                        Grid.Row="1"
                        SelectionMode="None" />
                </Grid>
            </TabViewItem>

            <TabViewItem x:Name="meta_tab" Header="Meta">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Text="Meta effects modify various aspects of mod itself on a regular basis to add more variety.&#x0a;They are not a part of the normal effects pool; instead, they are automatically dispatched by the mod on a fixed interval (configurable below)."
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center" />

                    <Grid Grid.Row="1" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="520" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Text="How often should a new meta start (in seconds)?" VerticalAlignment="Center" />
                            <TextBox x:Name="meta_effects_spawn_dur" Grid.Row="0" Grid.Column="1" Width="80" MaxLength="6" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="1" Text="How long should meta effects last (in seconds)?" VerticalAlignment="Center" />
                            <TextBox x:Name="meta_effects_timed_dur" Grid.Row="1" Grid.Column="1" Width="80" MaxLength="6" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="2" Text="How long should short timed meta effects last (in seconds)?" VerticalAlignment="Center" />
                            <TextBox x:Name="meta_effects_short_timed_dur" Grid.Row="2" Grid.Column="1" Width="80" MaxLength="6" HorizontalAlignment="Left" />
                        </Grid>

                        <TreeView x:Name="meta_effects_tree_view" Grid.Column="1" SelectionMode="None" />
                    </Grid>
                </Grid>
            </TabViewItem>
        </TabView>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock
                    x:Name="update_available_label"
                    VerticalAlignment="Center"
                    Text="A new version is available! Visit the GTA5-Mods thread for a download and changelogs."
                    TextWrapping="Wrap" />
                <Button
                    x:Name="update_available_button"
                    Content="GTA5-Mods"
                    Visibility="Collapsed"
                    Click="OpenModPageEvent" />
            </StackPanel>

            <Button x:Name="user_reset" Grid.Column="2" Content="Reset" Click="OnUserResetClick" />
            <Button x:Name="user_save" Grid.Column="3" Content="Save" Click="OnUserSaveClick" />
        </Grid>
    </Grid>
</Window>