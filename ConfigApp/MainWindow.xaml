<Window
    x:Class="ConfigApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tabs="using:ConfigApp.Tabs"
    xmlns:settingsTabs="using:ConfigApp.Tabs.Settings"
    xmlns:votingTabs="using:ConfigApp.Tabs.Voting"
    Title="ChaosModV Configuration">
    <Grid x:Name="MainRoot" Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="AppTitleBar"
                Grid.Row="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" Spacing="2">
                    <TextBlock Text="ChaosModV Configuration"
                               Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Manage effects, gameplay modes, voting, workshop content, and advanced settings"
                               Opacity="0.72"
                               TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="WinUI"
                           Opacity="0.7" />
            </Grid>
        </Border>

        <TabView x:Name="root_tabcontrol"
                 Grid.Row="1"
                 IsAddTabButtonVisible="False"
                 SelectionChanged="OnTabSelectionChanged">
            <TabViewItem Header="Effects">
                <Grid RowSpacing="10" Padding="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox
                        x:Name="effects_user_effects_search"
                        Width="340"
                        HorizontalAlignment="Left"
                        PlaceholderText="Search effects"
                        TextChanged="OnUserEffectSearchTextChanged" />

                    <Border Grid.Row="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8">
                        <TreeView
                            x:Name="effects_user_effects_tree_view"
                            SelectionMode="None" />
                    </Border>
                </Grid>
            </TabViewItem>

            <TabViewItem x:Name="meta_tab" Header="Meta">
                <Grid RowSpacing="12" Padding="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Text="Meta effects periodically modify how the mod behaves to increase variety. They are dispatched automatically and configured separately from the regular effects pool."
                        TextWrapping="Wrap" />

                    <Grid Grid.Row="1" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="460" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Text="Spawn interval (seconds)" VerticalAlignment="Center" />
                                <TextBox x:Name="meta_effects_spawn_dur" Grid.Row="0" Grid.Column="1" Width="90" MaxLength="6" HorizontalAlignment="Left" />

                                <TextBlock Grid.Row="1" Text="Default timed duration (seconds)" VerticalAlignment="Center" />
                                <TextBox x:Name="meta_effects_timed_dur" Grid.Row="1" Grid.Column="1" Width="90" MaxLength="6" HorizontalAlignment="Left" />

                                <TextBlock Grid.Row="2" Text="Short timed duration (seconds)" VerticalAlignment="Center" />
                                <TextBox x:Name="meta_effects_short_timed_dur" Grid.Row="2" Grid.Column="1" Width="90" MaxLength="6" HorizontalAlignment="Left" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8">
                            <TreeView x:Name="meta_effects_tree_view" SelectionMode="None" />
                        </Border>
                    </Grid>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Settings">
                <settingsTabs:SettingsTab x:Name="settings_tab" />
            </TabViewItem>

            <TabViewItem Header="Voting">
                <votingTabs:VotingTab x:Name="voting_tab" />
            </TabViewItem>

            <TabViewItem Header="Workshop">
                <tabs:WorkshopTab x:Name="workshop_tab" />
            </TabViewItem>

            <TabViewItem Header="More">
                <tabs:MoreTab x:Name="more_tab" />
            </TabViewItem>
        </TabView>

        <Border Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="update_available_label"
                        VerticalAlignment="Center"
                        Text="Checking for updates..."
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="update_available_button"
                        Content="Open GTA5-Mods"
                        Visibility="Collapsed"
                        Click="OpenModPageEvent" />
                </StackPanel>

                <Button x:Name="user_reset" Grid.Column="1" Content="Reset" Click="OnUserResetClick" />
                <Button x:Name="user_save" Grid.Column="2" Content="Save" Click="OnUserSaveClick" />
            </Grid>
        </Border>
    </Grid>
</Window>